-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=128;
DEPTH=8192;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
0000  :   0002 0002 0002 0002 0001 0001 0001 0001;
0001  :   0002 0002 0002 0002 0001 0001 0001 0001;
0002  :   0002 0002 0002 0002 0001 0001 0001 0001;
0003  :   0002 0002 0002 0002 0001 0001 0001 0001;
[0004..1FFF]  :   0000 0000 0000 0000 0000 0000 0000 0000 ;
%1FFF  :     1010 10 10101 01010  1111 11 11111 11111;%
END;
